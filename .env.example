# ==============================================================================
# NEXUS Environment Configuration Template
# Copy this file to .env and configure your local/deployment settings.
# ==============================================================================

# Server & Environment
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Persistence (SQLite source of truth)
DATABASE_URL=sqlite:///./nexus.db

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000

# AI / LLM Configuration
# Options: "mock" (default, deterministic offline mode) or "gemini" (Google GenAI)
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
